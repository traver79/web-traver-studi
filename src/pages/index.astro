---
import {withBase,absolute,route,languages} from '../utils/i18n';
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>TRAVER STUDI · Interiorisme</title><meta name="description" content="TRAVER STUDI — Calma, luz, materia y hogar. CA · ES · EN."/><link rel="canonical" href={absolute(withBase())}/>{languages.map(l=><link rel="alternate" hreflang={l} href={absolute(route(l))}/>)}<link rel="alternate" hreflang="x-default" href={absolute(withBase())}/><link rel="icon" href={withBase('brand/logo.svg')}/><meta name="theme-color" content="#FFF9F2"/><script is:inline define:vars={{base:withBase()}}>let preferred;try{preferred=localStorage.getItem('traver-language')}catch{}const browser=(navigator.languages?.[0] || navigator.language || 'en').split('-')[0].toLowerCase();const lang=['es','ca','en'].includes(preferred)?preferred:browser==='ca'?'ca':browser==='es'?'es':'en';location.replace(base+lang+'/');</script><style>body{margin:0;background:#FFF9F2;color:#656440;min-height:100svh;display:grid;place-content:center;font-family:Arial,sans-serif;text-align:center}img{width:min(70vw,400px);height:auto}nav{display:flex;gap:24px;justify-content:center}a{color:inherit;padding:16px;text-underline-offset:6px}</style></head><body><main><img src={withBase('brand/logo.svg')} width="2048" height="2048" alt="TRAVER STUDI"/><nav aria-label="Idioma"><a href={route('ca')} lang="ca">CA</a><a href={route('es')} lang="es">ES</a><a href={route('en')} lang="en">EN</a></nav></main></body></html>
