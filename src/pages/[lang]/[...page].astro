---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';import ProjectsPage from '../../components/ProjectsPage.astro';import StudioPage from '../../components/StudioPage.astro';import ServicesPage from '../../components/ServicesPage.astro';import ContactPage from '../../components/ContactPage.astro';import ProjectPage from '../../components/ProjectPage.astro';
import {getProjects} from '../../utils/projects';import {copy,languages,pageKeys,slugs,route,type Lang,type PageKey} from '../../utils/i18n';import type {CollectionEntry} from 'astro:content';
export async function getStaticPaths(){
 const projects=await getProjects();
 return languages.flatMap(lang=>[
  ...pageKeys.map(key=>({params:{lang,page:slugs[lang][key] || undefined},props:{lang,pageKey:key,projects}})),
  ...projects.map((project,i)=>({params:{lang,page:`${slugs[lang].projects}/${project.data.translations[lang].slug}`},props:{lang,pageKey:'projects',projects,project,next:projects.length>1?projects[(i+1)%projects.length]:undefined}}))
 ]);
}
interface Props {lang:Lang;pageKey:PageKey;projects:CollectionEntry<'projects'>[];project?:CollectionEntry<'projects'>;next?:CollectionEntry<'projects'>;}
const {lang,pageKey,projects,project,next}=Astro.props as Props;
const seo=project?.data.translations[lang].seo || copy[lang][pageKey];
const links=Object.fromEntries(languages.map(l=>[l,route(l,pageKey,project?.data.translations[l].slug)])) as Record<Lang,string>;
---
<BaseLayout lang={lang} page={pageKey} title={seo.title} description={seo.description} links={links}>
  {project ? <ProjectPage lang={lang} project={project} next={next}/> : pageKey==='home' ? <HomePage lang={lang} projects={projects}/> : pageKey==='projects' ? <ProjectsPage lang={lang} projects={projects}/> : pageKey==='studio' ? <StudioPage lang={lang}/> : pageKey==='services' ? <ServicesPage lang={lang}/> : <ContactPage lang={lang}/>}
</BaseLayout>
