---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, route, withBase, absolute, locales, languages, type Lang, type PageKey } from '../utils/i18n';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import contact from '../content/contact.json';
interface Props { lang: Lang; page?: PageKey; title: string; description: string; links?: Record<Lang,string>; image?: string; noindex?: boolean; }
const {lang,page='home',title,description,image,noindex=false}=Astro.props;
const links=Astro.props.links || Object.fromEntries(languages.map(l=>[l,route(l,page)])) as Record<Lang,string>;
const canonical=absolute(links[lang]);
const ogImage=image ? absolute(image) : absolute(withBase('social.jpg'));
const structured={ '@context':'https://schema.org', '@type':'ProfessionalService', name:'TRAVER STUDI', url:absolute(route(lang)), logo:absolute(withBase('brand/logo.svg')), description:copy[lang].studio.lead, foundingDate:'2026', email:contact.email, telephone:contact.phone, address:{'@type':'PostalAddress',streetAddress:'Sant Antoni Maria Claret, 209',postalCode:'08041',addressLocality:'Barcelona',addressCountry:'ES'} };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} · TRAVER STUDI</title><meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    {languages.map(l=><link rel="alternate" hreflang={l} href={absolute(links[l])}/>)}
    <link rel="alternate" hreflang="x-default" href={page==='home'?absolute(withBase()):absolute(links.en)}/>
    <meta property="og:type" content="website"/><meta property="og:site_name" content="TRAVER STUDI"/>
    <meta property="og:title" content={`${title} · TRAVER STUDI`}/><meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:alt" content="TRAVER STUDI"/>
    <meta property="og:locale" content={locales[lang]}/>{languages.filter(l=>l!==lang).map(l=><meta property="og:locale:alternate" content={locales[l]}/>)}
    <meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#FFF9F2"/>
    <link rel="icon" type="image/svg+xml" href={withBase('brand/logo.svg')}/>
    {noindex && <meta name="robots" content="noindex,follow"/>}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>
    <script is:inline>document.documentElement.classList.add('js');try{if(sessionStorage.getItem('traver-intro'))document.documentElement.classList.add('intro-seen')}catch{}</script>
  </head>
  <body id="top">
    <Header lang={lang} page={page} links={links}/>
    <main id="main" tabindex="-1"><slot/></main>
    <Footer lang={lang}/>
    <script>import '../utils/client';</script>
  </body>
</html>
