---
import {copy,withBase,type Lang} from '../utils/i18n';import contact from '../content/contact.json';
interface Props {lang:Lang;}const {lang}=Astro.props;const t=copy[lang];
---
<section class="contact-page section-pad"><div><p class="label">{t.contact.title}</p><h1 class="display-large">{t.contact.heading}</h1><p class="body-large">{t.contact.lead}</p><dl class="contact-details"><div><dt>{t.ui.email}</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div><div><dt>{t.ui.phone}</dt><dd><a href={`tel:${contact.phone.replace(/\s/g,'')}`}>{contact.phone}</a></dd></div><div><dt>{t.ui.address}</dt><dd>{contact.address}</dd></div></dl><div class="contact-actions"><a class="text-link" href={contact.whatsapp}>{t.contact.whatsappLabel}<span aria-hidden="true">↗</span></a><a class="text-link" href={contact.map}>{t.contact.mapLabel}<span aria-hidden="true">↗</span></a></div></div><img class="contact-seal" src={withBase('brand/logo.svg')} alt="" width="2048" height="2048"/></section>
<section id="enquiry" class="enquiry section-pad"><div><h2 class="display-medium">{t.contact.form.title}</h2><p>{t.contact.form.intro}</p></div><form action={`mailto:${contact.email}`} method="post" enctype="text/plain" data-enquiry data-email={contact.email} data-subject={t.contact.form.subject} data-ready={t.contact.form.ready} data-copied={t.contact.form.copied} data-copy-error={t.contact.form.copyError}>
  <div class="form-row"><label for="name">{t.contact.form.name}<input id="name" name="name" autocomplete="name" required maxlength="120"/></label><label for="email">{t.contact.form.email}<input id="email" name="email" type="email" autocomplete="email" required maxlength="200"/></label></div>
  <div class="form-row"><label for="phone">{t.contact.form.phone}<input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/></label><label for="service">{t.contact.form.service}<select id="service" name="service" required><option value="">{t.contact.form.select}</option>{t.services.items.map((s,i)=><option value={i+1}>{s.title}</option>)}</select></label></div>
  <label for="message">{t.contact.form.message}<textarea id="message" name="message" required rows="5" maxlength="1500"></textarea></label>
  <p class="form-note" id="form-note">{t.contact.form.privacy}</p><div class="form-actions"><button class="text-link" type="submit" aria-describedby="form-note">{t.contact.form.submit}<span aria-hidden="true">↗</span></button><button class="text-link" type="button" data-copy-enquiry>{t.contact.form.copy}</button></div><p data-form-status role="status" class="form-status"></p>
  <noscript><p><a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a></p></noscript>
</form></section>
