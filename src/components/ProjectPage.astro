---
import type {CollectionEntry} from 'astro:content';import {getImage} from 'astro:assets';import Photo from './Photo.astro';import {copy,route,type Lang} from '../utils/i18n';
interface Props {lang:Lang;project:CollectionEntry<'projects'>;next?:CollectionEntry<'projects'>;}
const {lang,project,next}=Astro.props;const p=project.data;const t=p.translations[lang];const ui=copy[lang].ui;
const largeImages=await Promise.all(p.gallery.map(g=>getImage({src:g.src,width:Math.min(g.src.width,1600),format:'webp',quality:90})));
---
<section class="project-hero"><div class="project-intro"><a class="text-link" href={route(lang,'projects')}>{copy[lang].projects.title}</a><h1 class="display-large">{t.title}</h1>{t.description.length ? <p class="body-large">{t.description[0]}</p> : <p class="editorial-note">{copy[lang].projects.missingDescription}</p>}<a class="label" href="#gallery">{ui.gallery} ↓</a></div><Photo src={p.cover} alt={p.coverAlt[lang]} eager/></section>
<section class="project-facts section-pad" aria-label={ui.details}><dl>{[[ui.location,t.location],[ui.year,p.year],[ui.type,t.category],[ui.credits,p.credits]].map(([label,value])=><div><dt class="label">{label}</dt><dd>{value || ui.pending}</dd></div>)}</dl>{t.description.slice(1).map(text=><p class="body-large">{text}</p>)}</section>
<section class="gallery section-pad" id="gallery" aria-label={ui.gallery}><div class="section-heading"><h2 class="label">{ui.gallery}</h2><span class="label">01 — {String(p.gallery.length).padStart(2,'0')}</span></div><div class="gallery-grid">{p.gallery.map((g,i)=><figure class:list={['gallery-item',{'landscape':g.src.width>g.src.height}]}><a href={largeImages[i].src} data-gallery-index={i} aria-label={`${ui.openImage}: ${g.alt[lang]}`} data-alt={g.alt[lang]}><Photo src={g.src} alt={g.alt[lang]} sizes={g.src.width>g.src.height?'(max-width: 767px) 92vw, 88vw':'(max-width: 767px) 92vw, 43vw'}/><span class="image-action" aria-hidden="true">+</span></a><figcaption><span>{String(i+1).padStart(2,'0')}</span><span>{g.alt[lang]}</span></figcaption></figure>)}</div></section>
<section class="project-next section-pad"><p class="label">{next ? ui.next : ui.back}</p><a href={route(lang,'projects',next?.data.translations[lang].slug)} class="display-medium">{next ? next.data.translations[lang].title : copy[lang].projects.title}<span aria-hidden="true">↗</span></a></section>
<dialog class="lightbox" aria-label={ui.gallery} data-lightbox><div class="lightbox-top"><span data-counter aria-live="polite"></span><button data-lightbox-close class="close-button">{ui.close} <span aria-hidden="true">×</span></button></div><div class="lightbox-stage"><button data-lightbox-prev aria-label={ui.previousImage}>←</button><img data-lightbox-image alt=""/><button data-lightbox-next aria-label={ui.nextImage}>→</button></div><p data-lightbox-caption></p></dialog>
