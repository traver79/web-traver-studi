---
import { copy, route, withBase, type Lang } from '../utils/i18n';
import contact from '../content/contact.json';
interface Props { lang: Lang; }
const {lang}=Astro.props;const t=copy[lang];
---
<footer class="site-footer">
  <div class="footer-statement"><p>{t.contact.footerHeading}</p><a class="text-link" href={route(lang,'contact')}>{t.contact.footerLink}<span aria-hidden="true">↗</span></a></div>
  <div class="footer-grid">
    <a class="footer-logo" href={route(lang)} aria-label={`TRAVER STUDI · ${t.nav.home}`}><img src={withBase('brand/logo-inverse.svg')} width="2048" height="2048" alt="TRAVER STUDI" loading="lazy" /></a>
    <div><p class="label">TRAVER STUDI</p><nav aria-label={t.nav.studio}>{(['projects','studio','services','contact'] as const).map(p=><a href={route(lang,p)}>{t.nav[p]}</a>)}</nav></div>
    <div class="footer-contact"><p class="label">{t.nav.contact}</p><a href={`mailto:${contact.email}`}>{contact.email}</a><a href={`tel:${contact.phone.replace(/\s/g,'')}`}>{contact.phone}</a><a href={contact.whatsapp}>WhatsApp ↗</a><p>{contact.address}</p></div>
  </div>
  <div class="footer-bottom"><span>© TRAVER STUDI</span><span>{t.contact.footerNote}</span><a href="#top">{t.ui.top} ↑</a><span>2026</span></div>
</footer>
