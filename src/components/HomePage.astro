---
import type {CollectionEntry} from 'astro:content';
import Intro from './Intro.astro';import ProjectCard from './ProjectCard.astro';
import {copy,route,withBase,type Lang} from '../utils/i18n';
interface Props {lang:Lang;projects:CollectionEntry<'projects'>[];}
const {lang,projects}=Astro.props;const t=copy[lang];const featured=projects.filter(p=>p.data.featured);
---
<Intro/>
<section class="home-hero">
  <div class="hero-identity"><h1><span class="sr-only">TRAVER STUDI · {t.home.title}</span><img class="hero-logo" src={withBase('brand/logo.svg')} width="2048" height="2048" alt="" fetchpriority="high"/></h1><p class="label">{t.home.eyebrow}</p><a class="hero-explore label" href="#selected">{t.ui.explore} <span aria-hidden="true">↓</span></a></div>
  <div class="hero-values" aria-hidden="true">{t.studio.values.map(v=><span>{v.title}.</span>)}</div>
</section>
<section class="intro-statement section-pad" data-reveal><span class="label">TRAVER STUDI</span><div><h2 class="display-medium">{t.home.heading}</h2><p class="body-large">{t.home.intro}</p><a class="text-link" href={route(lang,'studio')}>{t.ui.discover}<span aria-hidden="true">↗</span></a></div></section>
<section class="selected section-pad" id="selected"><div class="section-heading"><p class="label">{t.ui.selectedProjects}</p><p>{t.home.projectNote}</p></div><div class:list={['project-grid',{'single-project':featured.length===1}]}>{featured.map((p,i)=><ProjectCard project={p} lang={lang} index={i}/>)}</div><div class="section-end"><a class="text-link" href={route(lang,'projects')}>{t.ui.allProjects}<span aria-hidden="true">↗</span></a></div></section>
<section class="home-services section-pad"><div class="section-heading"><span class="label">{t.nav.services}</span><h2 class="display-medium">{t.home.servicesTitle}</h2></div>{t.services.notice && <p class="editorial-note">{t.services.notice}</p>}<div class="service-index">{t.services.items.map((s,i)=><a href={`${route(lang,'services')}#service-${i+1}`}><span class="label">0{i+1}</span><h3>{s.title}</h3><span aria-hidden="true">↗</span></a>)}</div></section>
