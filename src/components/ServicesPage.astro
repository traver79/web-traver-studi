---
import Photo from './Photo.astro';import imageA from '../assets/projects/calle-mallorca/_M0A8049.jpg';import imageB from '../assets/projects/calle-mallorca/_M0A8075.jpg';import {copy,route,type Lang} from '../utils/i18n';
interface Props {lang:Lang;}const {lang}=Astro.props;const t=copy[lang];
---
<section class="page-head section-pad"><p class="label">{t.services.title}</p><h1 class="display-large">{t.services.heading}</h1><p class="body-large">{t.services.lead}</p>{t.services.notice && <p class="editorial-note">{t.services.notice}</p>}</section>
<section class="service-details section-pad">{t.services.items.map((s,i)=><article id={`service-${i+1}`}><span class="service-number">0{i+1}</span><div><h2>{s.title}</h2><p class="body-large">{s.text}</p><ul class="service-scope">{s.details.map(detail=><li>{detail}</li>)}</ul><a class="text-link" href={`${route(lang,'contact')}?service=${i+1}#enquiry`}>{s.cta}<span aria-hidden="true">↗</span></a></div></article>)}<p class="editorial-note">{t.services.scope}</p></section>
<div class="service-diptych section-pad"><Photo src={imageA} alt={{es:'Salón y cerramiento acristalado de Calle Mallorca',ca:'Sala i tancament de vidre de Carrer Mallorca',en:'Living room and glazed partition at Mallorca Street'}[lang]}/><Photo src={imageB} alt={{es:'Barra y estantes de cocina de Calle Mallorca',ca:'Barra i prestatges de cuina de Carrer Mallorca',en:'Kitchen counter and shelving at Mallorca Street'}[lang]}/></div>
